# Copy to privado/.env (git-ignored) and fill in only what you use. Empty = neutral default.

# --- About you (not secret) ---
# Your first name, so Groov can use it ("O usuário se chama ...").
GROOV_NOME_USUARIO=
# City for the weather: name, latitude and longitude (decimal point).
GROOV_CIDADE=
GROOV_LAT=
GROOV_LON=
# Beach for the morning briefing: place;latitude;longitude. Empty = no sea in the briefing.
GROOV_MAR=
# Folder of your Obsidian vault. Empty = vault/ inside this repository.
GROOV_VAULT=
# Netflix profile name to pick. Empty = Groov asks.
GROOV_PERFIL_NETFLIX=
# Extra wake phrases, comma-separated (besides "groov", "hey groov", "acorda groov", "groov acorda").
GROOV_FRASES_EXTRA=
# Names Whisper should listen for (shows, artists, people), comma-separated.
GROOV_HOTWORDS_EXTRA=
# Extra folders for tier-3 work, comma-separated full paths.
GROOV_WORKSPACES_EXTRA=

# --- Your keys (secret; never commit them) ---
# TypeSafe key for Jev triage. Empty = everything goes to Claude Haiku.
TYPESAFE_API_KEY=
# Google AI Studio key for web research (Gemini + Google Search). Empty = no research.
GOOGLE_API_KEY=
# Trello key and token (read-only use) and the board names to read, comma-separated.
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_QUADROS=
# Boards from TRELLO_QUADROS whose cards are only counted (new leads, stage changes), never chased as tasks.
TRELLO_QUADROS_CONTAGEM=
# Token of the "Playwright Extension" in Chrome, for the optional page probe.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
