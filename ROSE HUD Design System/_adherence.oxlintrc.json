      {
        "selector": "JSXOpeningElement[name.name='VoiceBars'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|height|barWidth|gap|tone|style|key|ref|className|style|children)$/]",
        "message": "<VoiceBars> doesn't accept that prop. Declared props: count, active, height, barWidth, gap, tone, style."
